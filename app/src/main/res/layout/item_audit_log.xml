<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_rounded_card"
    android:orientation="horizontal"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_audit_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_role_chip"
        android:gravity="center"
        android:text="✓"
        android:textColor="@color/status_success"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_audit_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Disetujui oleh RT 03"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_audit_notes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Tanda tangan digital kanvas terverifikasi."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_audit_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="17 Nov 2026 · 14.30 WITA"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
